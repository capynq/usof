{
  "name": "usof",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "NODE_ENV=development npm run start --workspace=api",
    "build": "npm run build --workspace=web",
    "db:init": "npm run db:init --workspace=api",
    "db:recreate": "npm run db:recreate --workspace=api"
  }
}
